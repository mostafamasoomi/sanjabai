# ══════════════════════════════════════════════
# Multiai Environment Configuration
# Copy to .env and fill in real values
# ══════════════════════════════════════════════

# ── Database ──────────────────────────────────
POSTGRES_USER=multiai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=multiai
DATABASE_URL=postgresql+asyncpg://multiai:CHANGE_ME_STRONG_PASSWORD@pg:5432/multiai

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ───────────────────────────────────
ADMIN_TOKEN=CHANGE_ME_ADMIN_SECRET
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS

# ── LiteLLM ──────────────────────────────────
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_KEY
LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY
LITELLM_URL=http://litellm:4000

# ── Tunnel/Proxy (optional) ──────────────────
# TUNNEL_TYPE=socks5
# TUNNEL_URL=socks5://user:pass@host:port

# ── LiteLLM (Bynara proxy) ────────────────────
BYNARA_API_KEY=sk-...
BYNARA_API_KEY_2=sk-...
# Full SOCKS5 proxy URL (e.g. socks5://user:pass@host:port)
SOCKS5_PROXY_URL=socks5://user:pass@multiai_tunnel:9090

# ── Admin Panel ───────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD
ADMIN_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=https://multiai.ir,http://localhost:3003

# ── Payments ─────────────────────────────────
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_CALLBACK_URL=https://yourdomain.com/payment/callback

# ── Telegram Bot ─────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token-here
