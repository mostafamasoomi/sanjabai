# ══════════════════════════════════════════════
# Sanjabai Environment Configuration
# Copy to .env and fill in real values
# ══════════════════════════════════════════════

# ── Database ──────────────────────────────────
POSTGRES_USER=sanjabai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sanjabai
DATABASE_URL=postgresql+asyncpg://sanjabai:CHANGE_ME_STRONG_PASSWORD@pg:5432/sanjabai

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ───────────────────────────────────
ADMIN_TOKEN=CHANGE_ME_ADMIN_SECRET
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS

# ── LiteLLM ──────────────────────────────────
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_KEY
LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY
LITELLM_URL=http://litellm:4000

# ── Tunnel/Proxy (optional) ──────────────────
# TUNNEL_TYPE=socks5
# TUNNEL_URL=socks5://user:pass@host:port

# ── 9Router (OpenAI-compatible gateway) ───────
# Set NINEROUTER_URL to enable it. Origin only, without /v1 — the adapter
# appends /v1 for the API and hits /health (unauthenticated) for liveness.
# Leave unset and 9Router is skipped entirely by discovery and health probing.
# NINEROUTER_URL=http://9router:20128
# NINEROUTER_API_KEY=
# NINEROUTER_ENABLED=false

# Which upstream user chat traffic goes to: litellm (default) or ninerouter.
# Discovery and health always cover every configured provider, so 9Router can
# be observed in production before this is switched over.
# CHAT_PROVIDER=litellm

# ── Model health ──────────────────────────────
# Probes are synthetic max_tokens=1 completions, so each sweep costs one output
# token per catalog model. The interval is long because real user traffic is
# also recorded and covers the models that actually matter.
# MODEL_HEALTH_PROBE_INTERVAL=600     # seconds between probe sweeps
# MODEL_HEALTH_PROBE_CONCURRENCY=4
# MODEL_HEALTH_WINDOW_MIN=30          # rolling window for the status rollup
# MODEL_HEALTH_DEGRADED_BELOW=0.85    # success rate under this => degraded
# MODEL_HEALTH_DOWN_BELOW=0.4         # success rate under this => down
# MODEL_HEALTH_DOWN_AFTER=3           # consecutive failures => down
# MODEL_HEALTH_SLOW_MS=15000          # p50 latency over this => degraded
# MODEL_HEALTH_RETENTION_DAYS=7
# MODEL_DISCOVERY_INTERVAL=3600       # seconds between catalog syncs

# ── LiteLLM (Bynara proxy) ────────────────────
BYNARA_API_KEY=sk-...
BYNARA_API_KEY_2=sk-...
# Full SOCKS5 proxy URL (e.g. socks5://user:pass@host:port)
SOCKS5_PROXY_URL=socks5://user:pass@sanjabai_tunnel:9090

# ── Admin Panel ───────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD
ADMIN_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=https://sanjabai.ir,http://localhost:3003

# ── Payments ─────────────────────────────────
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_CALLBACK_URL=https://yourdomain.com/payment/callback

# ── Telegram Bot ─────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token-here
