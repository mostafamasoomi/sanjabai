# ══════════════════════════════════════════════
# Sanjabai Environment Configuration
# Copy to .env and fill in real values
# ══════════════════════════════════════════════

# ── Database ──────────────────────────────────
POSTGRES_USER=sanjabai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sanjabai
DATABASE_URL=postgresql+asyncpg://sanjabai:CHANGE_ME_STRONG_PASSWORD@pg:5432/sanjabai

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ───────────────────────────────────
ADMIN_TOKEN=CHANGE_ME_ADMIN_SECRET
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS

# ── LiteLLM ──────────────────────────────────
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_KEY
LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY
LITELLM_URL=http://litellm:4000

# ── Tunnel/Proxy (optional) ──────────────────
# TUNNEL_TYPE=socks5
# TUNNEL_URL=socks5://user:pass@host:port

# ── 9Router (OpenAI-compatible gateway) ───────
# Set NINEROUTER_URL to enable it. Origin only, without /v1 — the adapter
# appends /v1 for the API and hits /health (unauthenticated) for liveness.
# Leave unset and 9Router is skipped entirely by discovery and health probing.
# NINEROUTER_URL=http://9router:20128
# NINEROUTER_API_KEY=
# NINEROUTER_ENABLED=false

# Which upstream user chat traffic goes to: litellm (default) or ninerouter.
# Discovery and health always cover every configured provider, so 9Router can
# be observed in production before this is switched over.
# CHAT_PROVIDER=litellm

# ── Model health ──────────────────────────────
# Probes are synthetic max_tokens=1 completions, so each sweep costs one output
# token per catalog model. The interval is long because real user traffic is
# also recorded and covers the models that actually matter.
# MODEL_HEALTH_PROBE_INTERVAL=600     # seconds between probe sweeps
# MODEL_HEALTH_PROBE_CONCURRENCY=4
# MODEL_HEALTH_WINDOW_MIN=30          # rolling window for the status rollup
# MODEL_HEALTH_DEGRADED_BELOW=0.85    # success rate under this => degraded
# MODEL_HEALTH_DOWN_BELOW=0.4         # success rate under this => down
# MODEL_HEALTH_DOWN_AFTER=3           # consecutive failures => down
# MODEL_HEALTH_SLOW_MS=15000          # p50 latency over this => degraded
# MODEL_HEALTH_RETENTION_DAYS=7
# MODEL_DISCOVERY_INTERVAL=3600       # seconds between catalog syncs

# ── LiteLLM (Bynara proxy) ────────────────────
BYNARA_API_KEY=sk-...
BYNARA_API_KEY_2=sk-...
# freellmapi and the SOCKS5 egress tunnel were removed 2026-08-22: freellmapi
# was test-only supply (all 307 of its catalog rows were 'maintenance') and the
# server now reaches upstreams directly, so no proxy is required.
# Optional internal backhaul HTTP proxy for Bynara traffic and the tgju.org
# rate lookup (content.py). Leave unset to go direct.
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

# ── Admin Panel ───────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD
ADMIN_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# ── CORS ─────────────────────────────────────
# sanjabai.ir is DEAD — the live domains are sanjabai.com / www / api.sanjabai.com.
# The browser reaches the API same-origin through the Next.js rewrite, so a wrong
# value here breaks only direct cross-origin calls to api.sanjabai.com (i.e. the
# developer API), which is exactly the case that looks fine until a customer tries it.
CORS_ORIGINS=https://sanjabai.com,https://www.sanjabai.com,http://localhost:3003

# ── Payments ─────────────────────────────────
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_CALLBACK_URL=https://yourdomain.com/payment/callback

# ── Telegram Bot ─────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token-here

# ── Status page / Uptime Kuma (backend/status_page.py) ────
# Internal compose service URL only -- uptime_kuma is not published to the
# host, so this must stay a service name, never an IP or a public hostname.
# Leave KUMA_BASE_URL unset to disable the status page fetch entirely
# (GET /status/summary still answers, with monitoringUp: false).
KUMA_BASE_URL=http://uptime_kuma:3001
# Slug of the status page created inside the Kuma admin UI.
KUMA_STATUS_SLUG=sanjabai

# ── Financial watchdog (backend/watchdog.py, sanjabai_watchdog service) ──
# Telegram bot used for CRITICAL/HIGH anomaly alerts (negative balances,
# wallet/ledger mismatches, upstream failure spikes, etc). Optional: leave
# blank and the watchdog logs findings instead of sending Telegram messages.
WATCHDOG_BOT_TOKEN=
WATCHDOG_CHAT_ID=

# ── Outbound token budget (backend/services/token_budget.py, Phase E) ──
# The whole thread used to be sent upstream every turn with no ceiling at
# all. These caps are the ceiling. Every default below was chosen against a
# measured number, not a guess -- read the comments in token_budget.py
# before changing one, and re-measure rather than tuning by feel.
#
# Messages kept in the outbound payload (system/injected messages are exempt
# and budgeted separately). 20 == 10 user/assistant exchanges.
MAX_HISTORY_MESSAGES=20
# Ceiling applied when the client sends no max_tokens. A client's own lower
# value is never raised; the catalog's per-model max_output_tokens still clamps.
DEFAULT_MAX_OUTPUT_TOKENS=4096
# Memory/soul/pinned context is re-injected on turn 1 and every N turns after.
# Injections are ephemeral -- a gated turn means the model sees NO context at
# all that turn, not "it already saw it". Set to 1 to inject on every turn.
INJECT_CONTEXT_EVERY_N_TURNS=4
# ...but a context block smaller than this is always injected: losing it is a
# pure quality loss with no saving worth having. Production today sits at
# ~102 chars, so the gate above is currently inert by design.
INJECT_ALWAYS_UNDER_CHARS=1500
