FROM postgres:16-alpine

# Install pgvector from release tarball (avoids git dependency)
RUN apk add --no-cache build-base postgresql16-dev curl && \
    curl -sL https://github.com/pgvector/pgvector/archive/refs/tags/v0.8.0.tar.gz | tar xz -C /tmp && \
    cd /tmp/pgvector-0.8.0 && \
    make && \
    cp vector.so /usr/local/lib/postgresql/ && \
    cp sql/vector--0.8.0.sql /usr/local/share/postgresql/extension/ && \
    cp vector.control /usr/local/share/postgresql/extension/ && \
    cd / && rm -rf /tmp/pgvector-0.8.0 && \
    apk del build-base postgresql16-dev curl

# Auto-create extension on first init
RUN echo "CREATE EXTENSION IF NOT EXISTS vector;" > /docker-entrypoint-initdb.d/00-pgvector.sql
