  - model_name: kr/llama-3.1-405b
    litellm_params:
      model: openai/llama-3.1-405b
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
      api_type: openai

litellm_settings:
  drop_params: true
  request_timeout: 60
  proxy: os.environ/SOCKS5_PROXY_URL
