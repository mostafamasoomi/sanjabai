    litellm_params:
      model: openai/claude-opus-4
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
      api_type: openai
  - model_name: kr/gpt-4o
    litellm_params:
      model: openai/gpt-4o
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
      api_type: openai
  - model_name: kr/gpt-4o-mini
    litellm_params:
      model: openai/gpt-4o-mini
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
      api_type: openai
  - model_name: kr/gemini-2.5-pro
    litellm_params:
      model: openai/gemini-2.5-pro
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
