model_list:
  - model_name: kr/bynara-auto
    litellm_params:
      model: openai/auto
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
      api_type: openai
  - model_name: kr/claude-3.5-sonnet
    litellm_params:
      model: openai/claude-3.5-sonnet
      api_base: https://router.bynara.id/v1
      api_key: os.environ/BYNARA_API_KEY
      api_type: openai
