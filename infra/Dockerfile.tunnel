FROM alpine:3.20
RUN apk add --no-cache openssh-client \
    && mkdir -p /root/.ssh && chmod 700 /root/.ssh
EXPOSE 9090
CMD ["sh", "-c", "chmod 600 /root/.ssh/id_ed25519 2>/dev/null; while true; do ssh -i /root/.ssh/id_ed25519 -p 22022 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -N -D 0.0.0.0:9090 root@89.169.55.129; echo 'tunnel down, retrying in 5s'; sleep 5; done"]
