FROM alpine:3.20
RUN apk add --no-cache openssh-client
COPY ssh_key /root/.ssh/id_ed25519
RUN chmod 600 /root/.ssh/id_ed25519
EXPOSE 9090
CMD ["sh", "-c", "apk add --no-cache openssh-client >/dev/null 2>&1; while true; do ssh -i /root/.ssh/id_ed25519 -p 22022 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -N -D 0.0.0.0:9090 root@89.169.55.129; echo 'tunnel down, retrying in 5s'; sleep 5; done"]
